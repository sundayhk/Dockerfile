# ====================================================
# 阶段 1: 编译阶段 (Builder)
# ====================================================
FROM debian:trixie-slim AS builder

ENV NGINX_VERSION=1.31.5

# 编译所需的工具和开发依赖
ENV NGINX_DEPS="build-essential libpcre2-dev zlib1g-dev libssl-dev libxml2-dev libxslt1-dev libexpat1-dev wget ca-certificates"

# Nginx 编译选项
ENV NGINX_CONFIG_OPTS="\
    --prefix=/etc/nginx \
    --sbin-path=/usr/sbin/nginx \
    --modules-path=/usr/lib/nginx/modules \
    --conf-path=/etc/nginx/nginx.conf \
    --error-log-path=/var/log/nginx/error.log \
    --http-log-path=/var/log/nginx/access.log \
    --pid-path=/run/nginx.pid \
    --lock-path=/run/nginx.lock \
    --http-client-body-temp-path=/var/cache/nginx/client_temp \
    --http-proxy-temp-path=/var/cache/nginx/proxy_temp \
    --http-fastcgi-temp-path=/var/cache/nginx/fastcgi_temp \
    --http-uwsgi-temp-path=/var/cache/nginx/uwsgi_temp \
    --http-scgi-temp-path=/var/cache/nginx/scgi_temp \
    --user=www-data \
    --group=www-data \
    --with-compat \
    --with-file-aio \
    --with-threads \
    --with-http_addition_module \
    --with-http_auth_request_module \
    --with-http_dav_module \
    --with-http_flv_module \
    --with-http_gunzip_module \
    --with-http_gzip_static_module \
    --with-http_mp4_module \
    --with-http_random_index_module \
    --with-http_realip_module \
    --with-http_secure_link_module \
    --with-http_slice_module \
    --with-http_ssl_module \
    --with-http_stub_status_module \
    --with-http_sub_module \
    --with-http_v2_module \
    --with-http_v3_module \
    --with-mail \
    --with-mail_ssl_module \
    --with-stream \
    --with-stream_realip_module \
    --with-stream_ssl_module \
    --with-stream_ssl_preread_module \
    --with-cc-opt='-O2' \
    --add-module=/tmp/nginx-dav-ext-module \
"

RUN set -x \
    && apt-get update \
    && apt-get install -y --no-install-recommends ${NGINX_DEPS} \
    && wget https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz -O /tmp/nginx.tar.gz \
    && tar -xzvf /tmp/nginx.tar.gz -C /tmp \
    && wget https://github.com/arut/nginx-dav-ext-module/archive/master.tar.gz -O /tmp/nginx-dav-ext-module.tar.gz \
    && mkdir -p /tmp/nginx-dav-ext-module \
    && tar -xzf /tmp/nginx-dav-ext-module.tar.gz -C /tmp/nginx-dav-ext-module --strip-components=1 \
    && cd /tmp/nginx-${NGINX_VERSION} \
    && sh -c "./configure ${NGINX_CONFIG_OPTS}" \
    && make -j$(nproc) \
    && make install

# ====================================================
# 阶段 2: 运行阶段 (Final Target)
# ====================================================
FROM debian:trixie-slim

# 只安装运行时必需的动态链接库（去除了所有编译器和开发头文件）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcre2-8-0 \
    zlib1g \
    libssl3 \
    libxml2 \
    libxslt1.1 \
    libexpat1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 从 builder 镜像中仅复制编译产物
COPY --from=builder /etc/nginx /etc/nginx
COPY --from=builder /usr/sbin/nginx /usr/sbin/nginx

# 创建运行目录、建立控制台日志软链接、设置权限
RUN mkdir -p /var/cache/nginx/client_temp \
             /var/cache/nginx/proxy_temp \
             /var/cache/nginx/fastcgi_temp \
             /var/cache/nginx/uwsgi_temp \
             /var/cache/nginx/scgi_temp \
             /var/log/nginx \
             /etc/nginx/conf.d \
    # 将日志收集重定向至 Docker 标准输出与标准错误流 (docker logs)
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log \
    && chown -R www-data:www-data /var/cache/nginx /var/log/nginx /etc/nginx \
    && chmod -R 755 /var/cache/nginx /var/log/nginx

EXPOSE 80 443

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
